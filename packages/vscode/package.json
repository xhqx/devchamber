{
  "name": "devchamber",
  "displayName": "DevChamber",
  "description": "%extension.description%",
  "version": "1.14.0",
  "publisher": "xhqx",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/xhqx/devchamber.git"
  },
  "qna": "https://discord.gg/ZYRSdnwwKA",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "claude",
    "gpt",
    "agent",
    "coding",
    "chatgpt",
    "groq",
    "assistant",
    "opencode",
    "devchamber"
  ],
  "icon": "assets/app-icon.png",
  "main": "./dist/extension.js",
  "l10n": "./l10n",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:devchamber.openSidebar",
    "onCommand:devchamber.generateCommitMessage",
    "onCommand:devchamber.attachExplorerToChat",
    "onView:devchamber.chatView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "devchamber",
          "title": "DevChamber",
          "icon": "assets/icon.svg"
        }
      ]
    },
    "views": {
      "devchamber": [
        {
          "type": "webview",
          "id": "devchamber.chatView",
          "name": "%views.chat.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "devchamber.openSidebar",
        "category": "DevChamber",
        "title": "%command.openSidebar.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "devchamber.focusChat",
        "category": "DevChamber",
        "title": "%command.focusChat.title%"
      },
      {
        "command": "devchamber.restartApi",
        "category": "DevChamber",
        "title": "%command.restartApi.title%"
      },
      {
        "command": "devchamber.showOpenCodeStatus",
        "category": "DevChamber",
        "title": "%command.showOpenCodeStatus.title%"
      },
      {
        "command": "devchamber.openAgentManager",
        "category": "DevChamber",
        "title": "%command.openAgentManager.title%",
        "icon": "$(circuit-board)"
      },
      {
        "command": "devchamber.openActiveSessionInEditor",
        "category": "DevChamber",
        "title": "%command.openActiveSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "devchamber.openNewSessionInEditor",
        "category": "DevChamber",
        "title": "%command.openNewSessionInEditor.title%",
        "icon": {
          "light": "assets/icon.svg",
          "dark": "assets/icon-titlebar.svg"
        }
      },
      {
        "command": "devchamber.openCurrentOrNewSessionInEditor",
        "category": "DevChamber",
        "title": "%command.openCurrentOrNewSessionInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "devchamber.addToContext",
        "category": "DevChamber",
        "title": "%command.addToContext.title%"
      },
      {
        "command": "devchamber.explain",
        "category": "DevChamber",
        "title": "%command.explain.title%"
      },
      {
        "command": "devchamber.improveCode",
        "category": "DevChamber",
        "title": "%command.improveCode.title%"
      },
      {
        "command": "devchamber.newSession",
        "category": "DevChamber",
        "title": "%command.newSession.title%",
        "icon": "$(add)"
      },
      {
        "command": "devchamber.showSettings",
        "category": "DevChamber",
        "title": "%command.showSettings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "devchamber.generateCommitMessage",
        "category": "DevChamber",
        "title": "%command.generateCommitMessage.title%",
        "icon": "$(sparkle)"
      },
      {
        "command": "devchamber.attachExplorerToChat",
        "category": "DevChamber",
        "title": "%command.attachExplorerToChat.title%"
      }
    ],
    "submenus": [
      {
        "id": "devchamber.submenu",
        "label": "DevChamber"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "devchamber.submenu",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "devchamber.attachExplorerToChat",
          "when": "resourceScheme == file && explorerResourceIsFolder == false",
          "group": "navigation@50"
        }
      ],
      "editor/title": [
        {
          "command": "devchamber.openNewSessionInEditor",
          "group": "navigation@1"
        }
      ],
      "scm/title": [
        {
          "command": "devchamber.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "scm/sourceControl": [
        {
          "command": "devchamber.generateCommitMessage",
          "when": "scmProvider == git",
          "group": "navigation@0"
        }
      ],
      "view/title": [
        {
          "command": "devchamber.generateCommitMessage",
          "when": "view == workbench.scm",
          "group": "navigation@0"
        },
        {
          "command": "devchamber.newSession",
          "when": "view == devchamber.chatView",
          "group": "navigation@1"
        },
        {
          "command": "devchamber.openCurrentOrNewSessionInEditor",
          "when": "view == devchamber.chatView",
          "group": "navigation@2"
        },
        {
          "command": "devchamber.openAgentManager",
          "when": "view == devchamber.chatView",
          "group": "navigation@3"
        },
        {
          "command": "devchamber.showSettings",
          "when": "view == devchamber.chatView",
          "group": "navigation@4"
        }
      ],
      "devchamber.submenu": [
        {
          "command": "devchamber.explain"
        },
        {
          "command": "devchamber.improveCode"
        },
        {
          "command": "devchamber.addToContext"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "bun run build",
    "build": "bun run build:extension && bun run build:webview",
    "build:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --minify --main-fields=module,main",
    "build:webview": "VITE_OPENCODE_URL=/api vite build",
    "dev": "concurrently -n \"ext,web\" -c \"cyan,magenta\" \"bun run watch:extension\" \"bun run dev:webview\"",
    "dev:webview": "vite",
    "watch:extension": "esbuild src/extension.ts --bundle --outfile=dist/extension.js --external:vscode --format=cjs --platform=node --watch --sourcemap --main-fields=module,main",
    "watch:webview": "vite build --watch",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.webview.json",
    "lint": "bun x eslint --ext .ts,.tsx src webview",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/vscode": "^1.85.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vscode/vsce": "^3.2.1",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.2"
  },
  "dependencies": {
    "@openchamber/ui": "workspace:*",
    "@opencode-ai/sdk": "1.17.12",
    "adm-zip": "^0.5.16",
    "jsonc-parser": "^3.3.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "yaml": "^2.8.1"
  }
}
